{
  "name": "shop-dashboard-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:shop-dashboard-web": "node dist/shop-dashboard-web/server/server.mjs",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:seed": "node scripts/seed-e2e-catalog.mjs",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "extract-i18n": "ng extract-i18n",
    "lighthouse": "lighthouse http://localhost:4000 --form-factor=mobile --screenEmulation.mobile --throttling-method=simulate --output=html --output-path=./lighthouse-report.html --chrome-flags=\"--headless\"",
    "lighthouse:product": "lighthouse http://localhost:4000/p/aceite-esencial-de-lavanda-30ml --form-factor=mobile --screenEmulation.mobile --throttling-method=simulate --output=html --output-path=./lighthouse-report-product.html --chrome-flags=\"--headless\""
  },
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/localize": "^22.1.6",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.8.1",
    "sass": "^1.104.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  }
}
